diff --git a/fusee/program/source/fusee_stratosphere.cpp b/fusee/program/source/fusee_stratosphere.cpp
index 884d691..8257b3c 100644
--- a/fusee/program/source/fusee_stratosphere.cpp
+++ b/fusee/program/source/fusee_stratosphere.cpp
@@ -942,6 +942,29 @@ namespace ams::nxboot {
             }
 
             /* TODO ams.tma2: add mount_host patches. */
+
+            /* OpenPak: skip the NCA header fixed-key (sig1) verdict so self-built store titles mount:  */
+            /* the tbz w0,#0 after the header-1 RSA verify -> nop. Offset = 0x100 KIP header + text vaddr. */
+            /* 22.5.0: vaddr 0x26838, derived from the decrypted KIP. 23.0.0: vaddr 0x278A8 / 0x278B8,    */
+            /* same branch per the public FS patch database (same FS hashes as above), not yet checked    */
+            /* against the decrypted KIP. Any other FS is left alone.                                     */
+            {
+                constexpr const u8 OpenpakNcaSig1Nop[] = { 0x1F, 0x20, 0x03, 0xD5 };
+                switch (fs_version) {
+                    case FsVersion_22_5_0:
+                    case FsVersion_22_5_0_Exfat:
+                        AddPatch(fs_meta, 0x26938, OpenpakNcaSig1Nop, sizeof(OpenpakNcaSig1Nop));
+                        break;
+                    case FsVersion_23_0_0:
+                        AddPatch(fs_meta, 0x279A8, OpenpakNcaSig1Nop, sizeof(OpenpakNcaSig1Nop));
+                        break;
+                    case FsVersion_23_0_0_Exfat:
+                        AddPatch(fs_meta, 0x279B8, OpenpakNcaSig1Nop, sizeof(OpenpakNcaSig1Nop));
+                        break;
+                    default:
+                        break;
+                }
+            }
         }
 
         /* Return the fs version we're using. */
diff --git a/stratosphere/loader/source/ldr_meta.cpp b/stratosphere/loader/source/ldr_meta.cpp
index 8747519..28733ff 100644
--- a/stratosphere/loader/source/ldr_meta.cpp
+++ b/stratosphere/loader/source/ldr_meta.cpp
@@ -165,7 +165,11 @@ namespace ams::ldr {
             const u8 *msg         = meta->acid->modulus;
             const size_t msg_size = meta->acid->size;
             const bool is_signature_valid = crypto::VerifyRsa2048PssSha256(sig, sig_size, mod, mod_size, exp, exp_size, msg, msg_size);
-            R_UNLESS(is_signature_valid || !IsEnabledProgramVerification(), ldr::ResultInvalidAcidSignature());
+            /* OpenPak: store titles (0x01FE...) are self-signed; accept their ACID signature.  */
+            /* check_verification_data stays false for them, so no sig2 check is forced.       */
+            const bool is_openpak_store_title = meta->acid->program_id_min.value >= 0x01FE000000000000ul &&
+                                                meta->acid->program_id_max.value <= 0x01FEFFFFFFFFFFFFul;
+            R_UNLESS(is_signature_valid || is_openpak_store_title || !IsEnabledProgramVerification(), ldr::ResultInvalidAcidSignature());
 
             meta->check_verification_data = is_signature_valid;
             R_SUCCEED();
