diff --git a/stratosphere/ams_mitm/source/bsd_mitm/bsd_shim.c b/stratosphere/ams_mitm/source/bsd_mitm/bsd_shim.c
new file mode 100644
index 0000000..2e9cbe4
--- /dev/null
+++ b/stratosphere/ams_mitm/source/bsd_mitm/bsd_shim.c
@@ -0,0 +1,72 @@
+/*
+ * bsd:u command forwarders for OpenPak's ip redirect mitm.
+ * Command ids and buffer types as libnx's bsd.c uses them.
+ */
+#include "bsd_shim.h"
+#include <stratosphere/sf/sf_mitm_dispatch.h>
+
+typedef struct {
+    s32 ret;
+    s32 errno_;
+} BsdOut;
+
+Result bsdConnectFwd(Service *s, s32 fd, const void *addr, size_t addr_size, s32 *out_ret, s32 *out_errno) {
+    BsdOut out;
+    Result rc = serviceMitmDispatchInOut(s, 14, fd, out,
+        .buffer_attrs = { SfBufferAttr_HipcAutoSelect | SfBufferAttr_In },
+        .buffers = { { addr, addr_size } },
+    );
+    if (R_SUCCEEDED(rc)) {
+        *out_ret = out.ret;
+        *out_errno = out.errno_;
+    }
+    return rc;
+}
+
+Result bsdSendToFwd(Service *s, s32 fd, s32 flags, const void *msg, size_t msg_size, const void *addr, size_t addr_size, s32 *out_ret, s32 *out_errno) {
+    const struct {
+        s32 fd;
+        s32 flags;
+    } in = { fd, flags };
+    BsdOut out;
+    Result rc = serviceMitmDispatchInOut(s, 11, in, out,
+        .buffer_attrs = {
+            SfBufferAttr_HipcAutoSelect | SfBufferAttr_In,
+            SfBufferAttr_HipcAutoSelect | SfBufferAttr_In,
+        },
+        .buffers = { { msg, msg_size }, { addr, addr_size } },
+    );
+    if (R_SUCCEEDED(rc)) {
+        *out_ret = out.ret;
+        *out_errno = out.errno_;
+    }
+    return rc;
+}
+
+Result bsdGetPeerNameFwd(Service *s, s32 fd, void *addr, size_t addr_size, s32 *out_ret, s32 *out_errno, u32 *out_addr_len) {
+    struct {
+        s32 ret;
+        s32 errno_;
+        u32 addr_len;
+    } out;
+    Result rc = serviceMitmDispatchInOut(s, 15, fd, out,
+        .buffer_attrs = { SfBufferAttr_HipcAutoSelect | SfBufferAttr_Out },
+        .buffers = { { addr, addr_size } },
+    );
+    if (R_SUCCEEDED(rc)) {
+        *out_ret = out.ret;
+        *out_errno = out.errno_;
+        *out_addr_len = out.addr_len;
+    }
+    return rc;
+}
+
+Result bsdCloseFwd(Service *s, s32 fd, s32 *out_ret, s32 *out_errno) {
+    BsdOut out;
+    Result rc = serviceMitmDispatchInOut(s, 26, fd, out);
+    if (R_SUCCEEDED(rc)) {
+        *out_ret = out.ret;
+        *out_errno = out.errno_;
+    }
+    return rc;
+}
