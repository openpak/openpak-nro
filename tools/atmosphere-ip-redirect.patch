+/* OpenPak: bsd:u for a program the ip redirect rules list. Connect (tcp rules) and SendTo (udp
+ * rules) go to the rule's target; GetPeerName keeps reporting the address the program dialled.
+ * Every other command is forwarded untouched by the mitm framework. */
+#define AMS_BSD_MITM_INTERFACE_INFO(C, H)                                                                                                                                                                        AMS_SF_METHOD_INFO(C, H, 11, Result, SendTo,      (sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd, s32 flags, const sf::InAutoSelectBuffer &msg, const sf::InAutoSelectBuffer &addr), (out_ret, out_errno, fd, flags, msg, addr))     AMS_SF_METHOD_INFO(C, H, 14, Result, Connect,     (sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd, const sf::InAutoSelectBuffer &addr),                                         (out_ret, out_errno, fd, addr))                    AMS_SF_METHOD_INFO(C, H, 15, Result, GetPeerName, (sf::Out<s32> out_ret, sf::Out<s32> out_errno, sf::Out<u32> out_addr_len, s32 fd, const sf::OutAutoSelectBuffer &addr),             (out_ret, out_errno, out_addr_len, fd, addr))      AMS_SF_METHOD_INFO(C, H, 26, Result, Close,       (sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd),                                                                              (out_ret, out_errno, fd))
+
+AMS_SF_DEFINE_MITM_INTERFACE(ams::mitm::bsd, IBsdMitm, AMS_BSD_MITM_INTERFACE_INFO, 0x4F504B31)
+
+namespace ams::mitm::bsd {
+
+    class BsdMitmService : public sf::MitmServiceImplBase {
+        public:
+            using MitmServiceImplBase::MitmServiceImplBase;
+        public:
+            static bool ShouldMitm(const sm::MitmProcessInfo &client_info) {
+                /* Only a program the rules name: everything else keeps its direct session. */
+                return ncm::IsApplicationId(client_info.program_id) && ReloadAndHasProgram(client_info.program_id);
+            }
+        public:
+            Result SendTo(sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd, s32 flags, const sf::InAutoSelectBuffer &msg, const sf::InAutoSelectBuffer &addr);
+            Result Connect(sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd, const sf::InAutoSelectBuffer &addr);
+            Result GetPeerName(sf::Out<s32> out_ret, sf::Out<s32> out_errno, sf::Out<u32> out_addr_len, s32 fd, const sf::OutAutoSelectBuffer &addr);
+            Result Close(sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd);
+    };
+    static_assert(IsIBsdMitm<BsdMitmService>);
