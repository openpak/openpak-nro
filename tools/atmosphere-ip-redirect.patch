+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#pragma once
+#include <stratosphere.hpp>
+
+/* OpenPak: destinations a title dials as a hard-coded IPv4 address, rewritten to the address the
+ * signed ceiling names (its "ip_redirects"). openpak-fetchd verifies the ceiling and writes the
+ * rules to /atmosphere/config/openpak/ip_redirects.txt, one per line:
+ *     <tcp|udp> <program id, 16 hex digits> <a.b.c.d:port> <e.f.g.h:port>
+ * Only a listed program's bsd:u sessions are taken over, and only a listed destination changes. */
+namespace ams::mitm::bsd {
+
+    struct Endpoint {
+        u32 address; /* network byte order, as in a sockaddr_in */
+        u16 port;    /* network byte order */
+    };
+
+    /* Re-reads the rules file; true when it lists the program. */
+    bool ReloadAndHasProgram(ncm::ProgramId program_id);
+
+    /* The target for a destination of this program, or false when it is not listed. */
+    bool FindRedirect(ncm::ProgramId program_id, bool tcp, const Endpoint &from, Endpoint *out);
+
+}
diff --git a/stratosphere/ams_mitm/source/bsd_mitm/bsdmitm_service.cpp b/stratosphere/ams_mitm/source/bsd_mitm/bsdmitm_service.cpp
new file mode 100644
index 0000000..441046f
--- /dev/null
+++ b/stratosphere/ams_mitm/source/bsd_mitm/bsdmitm_service.cpp
@@ -0,0 +1,129 @@
+/*
+ * Copyright (c) Atmosphère-NX
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms and conditions of the GNU General Public License,
+ * version 2, as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#include <stratosphere.hpp>
+#include "bsdmitm_service.hpp"
+#include "bsd_shim.h"
+
+namespace ams::mitm::bsd {
+
+    namespace {
+
+        /* A guest sockaddr_in (FreeBSD layout). */
+        struct SockAddrIn {
+            u8 len;
+            u8 family;
+            u16 port;
+            u32 address;
+            u8 zero[8];
+        };
+        static_assert(sizeof(SockAddrIn) == 0x10);
+        constexpr u8 AfInet = 2;
+
+        /* Sockets a redirected connect went out on, so getpeername keeps the dialled address.
+         * Descriptors belong to a process, and a process may hold several bsd:u sessions. */
+        struct Peer {
+            u64 process_id;
+            s32 fd;
+            SockAddrIn dialled;
+        };
+        constexpr size_t MaxPeers = 64;
+        constinit os::SdkMutex g_peer_lock;
+        constinit Peer g_peers[MaxPeers];
+        constinit size_t g_num_peers = 0;
+
+        void ForgetPeer(u64 process_id, s32 fd) {
+            std::scoped_lock lk(g_peer_lock);
+            for (size_t i = 0; i < g_num_peers; ++i) {
+                if (g_peers[i].process_id == process_id && g_peers[i].fd == fd) {
+                    g_peers[i] = g_peers[--g_num_peers];
+                    return;
+                }
+            }
+        }
+
+        void RememberPeer(u64 process_id, s32 fd, const SockAddrIn &dialled) {
+            ForgetPeer(process_id, fd);
+            std::scoped_lock lk(g_peer_lock);
+            if (g_num_peers < MaxPeers) {
+                g_peers[g_num_peers++] = Peer{ process_id, fd, dialled };
+            }
+        }
+
+        bool FindPeer(u64 process_id, s32 fd, SockAddrIn *out) {
+            std::scoped_lock lk(g_peer_lock);
+            for (size_t i = 0; i < g_num_peers; ++i) {
+                if (g_peers[i].process_id == process_id && g_peers[i].fd == fd) {
+                    *out = g_peers[i].dialled;
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        /* The rewritten copy of a guest address when a rule lists it. */
+        bool Rewrite(ncm::ProgramId program_id, bool tcp, const sf::InAutoSelectBuffer &addr, SockAddrIn *out) {
+            if (addr.GetSize() < sizeof(SockAddrIn)) {
+                return false;
+            }
+            std::memcpy(out, addr.GetPointer(), sizeof(SockAddrIn));
+            if (out->family != AfInet) {
+                return false;
+            }
+            Endpoint to;
+            if (!FindRedirect(program_id, tcp, Endpoint{ out->address, out->port }, std::addressof(to))) {
+                return false;
+            }
+            out->address = to.address;
+            out->port    = to.port;
+            return true;
+        }
+
+    }
+
+    Result BsdMitmService::Connect(sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd, const sf::InAutoSelectBuffer &addr) {
+        SockAddrIn rewritten;
+        const bool redirected = Rewrite(m_client_info.program_id, true, addr, std::addressof(rewritten));
+        if (redirected) {
+            RememberPeer(m_client_info.process_id.value, fd, *reinterpret_cast<const SockAddrIn *>(addr.GetPointer()));
+        } else {
+            ForgetPeer(m_client_info.process_id.value, fd);
+        }
+        const void *buf = redirected ? static_cast<const void *>(std::addressof(rewritten)) : static_cast<const void *>(addr.GetPointer());
+        R_RETURN(bsdConnectFwd(m_forward_service.get(), fd, buf, redirected ? sizeof(rewritten) : addr.GetSize(), out_ret.GetPointer(), out_errno.GetPointer()));
+    }
+
+    Result BsdMitmService::SendTo(sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd, s32 flags, const sf::InAutoSelectBuffer &msg, const sf::InAutoSelectBuffer &addr) {
+        SockAddrIn rewritten;
+        const bool redirected = Rewrite(m_client_info.program_id, false, addr, std::addressof(rewritten));
+        const void *buf = redirected ? static_cast<const void *>(std::addressof(rewritten)) : static_cast<const void *>(addr.GetPointer());
+        R_RETURN(bsdSendToFwd(m_forward_service.get(), fd, flags, msg.GetPointer(), msg.GetSize(), buf, redirected ? sizeof(rewritten) : addr.GetSize(), out_ret.GetPointer(), out_errno.GetPointer()));
+    }
+
+    Result BsdMitmService::GetPeerName(sf::Out<s32> out_ret, sf::Out<s32> out_errno, sf::Out<u32> out_addr_len, s32 fd, const sf::OutAutoSelectBuffer &addr) {
+        R_TRY(bsdGetPeerNameFwd(m_forward_service.get(), fd, addr.GetPointer(), addr.GetSize(), out_ret.GetPointer(), out_errno.GetPointer(), out_addr_len.GetPointer()));
+        SockAddrIn dialled;
+        if (*out_ret.GetPointer() == 0 && addr.GetSize() >= sizeof(dialled) && FindPeer(m_client_info.process_id.value, fd, std::addressof(dialled))) {
+            std::memcpy(addr.GetPointer(), std::addressof(dialled), sizeof(dialled));
+        }
+        R_SUCCEED();
+    }
+
+    Result BsdMitmService::Close(sf::Out<s32> out_ret, sf::Out<s32> out_errno, s32 fd) {
+        ForgetPeer(m_client_info.process_id.value, fd);
+        R_RETURN(bsdCloseFwd(m_forward_service.get(), fd, out_ret.GetPointer(), out_errno.GetPointer()));
+    }
+
+}
