diff --git a/stratosphere/ams_mitm/source/bsd_mitm/bsdmitm_redirects.cpp b/stratosphere/ams_mitm/source/bsd_mitm/bsdmitm_redirects.cpp
new file mode 100644
index 0000000..5607fdb
--- /dev/null
+++ b/stratosphere/ams_mitm/source/bsd_mitm/bsdmitm_redirects.cpp
@@ -0,0 +1,153 @@
+/*
+ * Copyright (c) Atmosphère-NX
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms and conditions of the GNU General Public License,
+ * version 2, as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#include <stratosphere.hpp>
+#include "../amsmitm_fs_utils.hpp"
+#include "bsdmitm_redirects.hpp"
+
+namespace ams::mitm::bsd {
+
+    namespace {
+
+        constexpr const char RulesPath[] = "/config/openpak/ip_redirects.txt";
+        constexpr size_t MaxRules = 32;
+        constexpr size_t MaxFileSize = 0x2000;
+
+        struct Rule {
+            u64 program_id;
+            bool tcp;
+            Endpoint from;
+            Endpoint to;
+        };
+
+        constinit os::SdkMutex g_lock;
+        constinit Rule g_rules[MaxRules];
+        constinit size_t g_num_rules = 0;
+        constinit char g_file_buffer[MaxFileSize + 1];
+
+        u16 Swap16(u16 v) { return static_cast<u16>((v << 8) | (v >> 8)); }
+
+        bool ParseNumber(const char *&p, u64 max, int base, u64 *out) {
+            u64 v = 0;
+            int digits = 0;
+            while (true) {
+                const char c = *p;
+                int d;
+                if (c >= '0' && c <= '9') { d = c - '0'; }
+                else if (base == 16 && c >= 'a' && c <= 'f') { d = c - 'a' + 10; }
+                else if (base == 16 && c >= 'A' && c <= 'F') { d = c - 'A' + 10; }
+                else { break; }
+                v = v * base + d;
+                if (v > max || ++digits > 16) { return false; }
+                ++p;
+            }
+            *out = v;
+            return digits > 0;
+        }
+
+        bool ParseEndpoint(const char *&p, Endpoint *out) {
+            u32 ip = 0;
+            for (int i = 0; i < 4; ++i) {
+                u64 octet;
+                if (!ParseNumber(p, 255, 10, std::addressof(octet))) { return false; }
+                ip = (ip << 8) | static_cast<u32>(octet);
+                if (i < 3) {
+                    if (*p != '.') { return false; }
+                    ++p;
+                }
+            }
+            if (*p != ':') { return false; }
+            ++p;
+            u64 port;
+            if (!ParseNumber(p, 65535, 10, std::addressof(port)) || port == 0) { return false; }
+            /* Stored in network order, as a guest sockaddr_in holds them. */
+            out->address = __builtin_bswap32(ip);
+            out->port    = Swap16(static_cast<u16>(port));
+            return true;
+        }
+
+        void SkipSpaces(const char *&p) { while (*p == ' ' || *p == '\t') { ++p; } }
+
+        /* One line; a malformed line is skipped (fetchd only writes verified rules). */
+        bool ParseLine(const char *p, Rule *out) {
+            SkipSpaces(p);
+            if (std::strncmp(p, "tcp", 3) == 0) { out->tcp = true; }
+            else if (std::strncmp(p, "udp", 3) == 0) { out->tcp = false; }
+            else { return false; }
+            p += 3;
+            SkipSpaces(p);
+            if (!ParseNumber(p, std::numeric_limits<u64>::max(), 16, std::addressof(out->program_id))) { return false; }
+            SkipSpaces(p);
+            if (!ParseEndpoint(p, std::addressof(out->from))) { return false; }
+            SkipSpaces(p);
+            if (!ParseEndpoint(p, std::addressof(out->to))) { return false; }
+            SkipSpaces(p);
+            return *p == '\x00' || *p == '\r' || *p == '#';
+        }
+
+        void ReloadLocked() {
+            g_num_rules = 0;
+            ::FsFile file;
+            if (R_FAILED(mitm::fs::OpenAtmosphereSdFile(std::addressof(file), RulesPath, ams::fs::OpenMode_Read))) {
+                return;
+            }
+            ON_SCOPE_EXIT { ::fsFileClose(std::addressof(file)); };
+            s64 size = 0;
+            if (R_FAILED(::fsFileGetSize(std::addressof(file), std::addressof(size))) || size <= 0 || size > static_cast<s64>(MaxFileSize)) {
+                return;
+            }
+            u64 read = 0;
+            if (R_FAILED(::fsFileRead(std::addressof(file), 0, g_file_buffer, size, ::FsReadOption_None, std::addressof(read))) || read != static_cast<u64>(size)) {
+                return;
+            }
+            g_file_buffer[size] = '\x00';
+
+            char *line = g_file_buffer;
+            while (line != nullptr && *line != '\x00' && g_num_rules < MaxRules) {
+                char *next = std::strchr(line, '\n');
+                if (next != nullptr) { *next++ = '\x00'; }
+                if (*line != '#' && ParseLine(line, g_rules + g_num_rules)) {
+                    ++g_num_rules;
+                }
+                line = next;
+            }
+        }
+
+    }
+
+    bool ReloadAndHasProgram(ncm::ProgramId program_id) {
+        std::scoped_lock lk(g_lock);
+        ReloadLocked();
+        for (size_t i = 0; i < g_num_rules; ++i) {
+            if (g_rules[i].program_id == program_id.value) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    bool FindRedirect(ncm::ProgramId program_id, bool tcp, const Endpoint &from, Endpoint *out) {
+        std::scoped_lock lk(g_lock);
+        for (size_t i = 0; i < g_num_rules; ++i) {
+            const Rule &r = g_rules[i];
+            if (r.program_id == program_id.value && r.tcp == tcp && r.from.address == from.address && r.from.port == from.port) {
+                *out = r.to;
+                return true;
+            }
+        }
+        return false;
+    }
+
+}
diff --git a/stratosphere/ams_mitm/source/bsd_mitm/bsdmitm_redirects.hpp b/stratosphere/ams_mitm/source/bsd_mitm/bsdmitm_redirects.hpp
